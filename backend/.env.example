# ── LLM provider keys (used as fallback when the user doesn't supply their own) ──
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173 (Vite dev server)
# Production: set to your deployed frontend URL(s)
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# ── File uploads ──────────────────────────────────────────────────────────────
# Maximum upload size in MB (default: 10)
# MAX_UPLOAD_MB=10

# Directory where uploaded files are stored.
# Production (Fly.io): set to the path of your persistent volume mount, e.g. /data/uploads
# UPLOAD_DIR=./uploads

# How long uploaded files are kept before being purged (seconds, default: 7200 = 2 hours)
# FILE_TTL_SECONDS=7200

# How often the cleanup task runs (seconds, default: 3600 = 1 hour)
# CLEANUP_INTERVAL_SECONDS=3600

# ── Conversation limits ───────────────────────────────────────────────────────
# Maximum number of messages allowed per chat request (default: 50)
# MAX_MESSAGES=50

# Maximum characters per message (default: 8000)
# MAX_MESSAGE_LENGTH=8000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Set to "false" to disable rate limiting (useful in development/testing)
# RATELIMIT_ENABLED=true

# Limits are expressed as "N/period" where period is second, minute, or hour
# RATELIMIT_UPLOAD=10/minute
# RATELIMIT_CHAT=30/minute

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# ── Sentry (optional error tracking) ─────────────────────────────────────────
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENVIRONMENT=production
