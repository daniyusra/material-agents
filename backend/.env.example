# ── LLM provider keys (used as fallback when the user doesn't supply their own) ──
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173 (Vite dev server)
# Production: set to your deployed frontend URL(s)
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# ── File uploads ──────────────────────────────────────────────────────────────
# Maximum upload size in MB (default: 10)
# MAX_UPLOAD_MB=10

# Directory where uploaded files are stored.
# Production (Fly.io): set to the path of your persistent volume mount, e.g. /data/uploads
# UPLOAD_DIR=./uploads

# How long uploaded files are kept before being purged (seconds, default: 7200 = 2 hours)
# FILE_TTL_SECONDS=7200

# How often the cleanup task runs (seconds, default: 3600 = 1 hour)
# CLEANUP_INTERVAL_SECONDS=3600

# ── Conversation limits ───────────────────────────────────────────────────────
# Maximum number of messages allowed per chat request (default: 50)
# MAX_MESSAGES=50

# Maximum characters per message (default: 8000)
# MAX_MESSAGE_LENGTH=8000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Set to "false" to disable rate limiting (useful in development/testing)
# RATELIMIT_ENABLED=true

# Limits are expressed as "N/period" where period is second, minute, or hour
# RATELIMIT_UPLOAD=10/minute
# RATELIMIT_CHAT=30/minute

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# ── Sentry (optional error tracking) ─────────────────────────────────────────
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the blog (and future features).
# Set via Fly secrets in production — never commit a real value here.
# Local dev example: postgresql://postgres:postgres@localhost:5432/material_agents
# DATABASE_URL=

# For running tests against a dedicated test database:
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_blog

# ── Blog ──────────────────────────────────────────────────────────────────────
# Set to "true" to enable all blog routes and the admin panel.
# BLOG_ENABLED=false

# Admin credentials — never store plaintext passwords.
# Generate the hash with: uv run python scripts/gen_password_hash.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Secret for signing session tokens. Must be at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# Session lifetime (hours). Logout clears the cookie client-side.
# SESSION_TTL_HOURS=12

# Set to "false" in local HTTP dev; must be "true" in production (Fly.io enforces HTTPS).
# COOKIE_SECURE=true

# Login rate limit (slowapi format). Default: 5 attempts per minute per IP.
# RATELIMIT_LOGIN=5/minute

# Storage backend for blog media: "local" (Fly.io volume) or "s3".
# MEDIA_BACKEND=local

# Local media directory. Production (Fly.io): /data/media (must be on persistent volume)
# MEDIA_DIR=./media

# Absolute origin prepended to /media/... URLs returned by the upload endpoint.
# Leave empty in local dev (Vite proxies /media to the backend).
# Production: set to your backend URL so stored URLs are absolute and resolve correctly
# from the frontend's domain.
# MEDIA_BASE_URL=https://your-backend.fly.dev

# Per-upload size cap in MB (shared with data uploads).
# MAX_UPLOAD_MB=10

# Longest edge (px) images are resized to on upload.
# MEDIA_MAX_DIMENSION=2048

# Absolute origin used for canonical URLs, sitemap, OG tags, and the RSS feed.
# Required for SEO/social sharing to work correctly.
# SITE_BASE_URL=https://yourapp.vercel.app

# ── WhatsApp bot (Evolution API) ──────────────────────────────────────────────
# Set to "true" to enable the bot (routes, DB init, scheduler).
# Defaults to "false" — must be explicitly enabled in dev.
# WHATSAPP_ENABLED=false

# URL of your Evolution API Docker container (no trailing slash)
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_INSTANCE=default
# EVOLUTION_API_KEY=your-evolution-api-key

# Optional: reject webhook calls that don't include this secret header
# WHATSAPP_WEBHOOK_SECRET=

# SQLite database path for WhatsApp bot data (default: backend/whatsapp.db)
# WHATSAPP_DB_PATH=./whatsapp.db
